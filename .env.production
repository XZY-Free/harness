# ───────── 生产环境（APP_ENV=production）─────────
# ⚠️  切勿在此文件填写真实密钥！生产环境变量由部署平台（K8s / Docker -e）注入。
# ⚠️  此文件仅作模板参考和本地验证构建之用。
#
# 启动方式：APP_ENV=production pnpm start

# 【必填】MySQL 连接串 — 由部署平台注入
DATABASE_URL=

# 【必填】LLM 密钥 — 由部署平台注入
LLM_API_KEY=

# 【必填】OpenAI 兼容端点 base url — 生产环境网关
LLM_BASE_URL=

# 【Hosted 必填】受管制品证明与独立 Conformance Runner 服务
SNOW_HOSTED_EVIDENCE_SERVICE_URL=
SNOW_HOSTED_EVIDENCE_SERVICE_TOKEN=
SNOW_HOSTED_BUILDER_KEYS_JSON=
SNOW_RUNNER_SIGNING_IDENTITIES_JSON=
SNOW_HOSTED_EVIDENCE_TIMEOUT_MS=30000

# 【可选】模型名
SNOW_CHAT_MODEL=deepseek-v4-flash
SNOW_TITLE_MODEL=qwen-turbo

# 【可选】工作区文件根目录
SNOW_WORKSPACES_DIR=/data/workspaces

# ─── 认证 / SSO（Phase 4-3）───
# ⚠️ 生产必须 trusted-headers：用户身份由公司网关 / SSO 代理注入下列 header，
#    应用只消费已认证身份。SNOW_AUTH_MODE=dev 在生产会被 assertRuntimeConfig 拒绝。
SNOW_AUTH_MODE=trusted-headers
SNOW_AUTH_HEADER_EXTERNAL_ID=x-snow-user-id
SNOW_AUTH_HEADER_EMAIL=x-snow-user-email
SNOW_AUTH_HEADER_NAME=x-snow-user-name

# ─── Agent Studio 后台（Phase 4-4）───
# 生产强制 false：默认用户不得直进 /studio，权限由 UserRole 表决定（无角色 → 403）
SNOW_STUDIO_OPEN=false
