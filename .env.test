# ───────── 测试环境（APP_ENV=test）─────────
# 连接测试集群时使用。实际密钥请写入 .env.test.local（已被 git 忽略）。
#
# 启动方式：APP_ENV=test pnpm dev

# 【必填】MySQL 连接串 — 测试环境数据库
DATABASE_URL=mysql://snow_test:test_password@test-mysql.internal:3306/snow_harness

# 【必填】LLM 密钥
LLM_API_KEY=

# 【必填】OpenAI 兼容端点 base url — 测试环境网关
LLM_BASE_URL=https://llm-gateway.test.internal/v1

# 【可选】模型名
SNOW_CHAT_MODEL=deepseek-v4-flash
SNOW_TITLE_MODEL=qwen-turbo

# 【可选】工作区文件根目录
SNOW_WORKSPACES_DIR=/data/workspaces

# ─── 认证 / SSO（Phase 4-3）───
# 测试环境用 dev 固定默认用户，保证现有单测兼容
SNOW_AUTH_MODE=dev
SNOW_AUTH_HEADER_EXTERNAL_ID=x-snow-user-id
SNOW_AUTH_HEADER_EMAIL=x-snow-user-email
SNOW_AUTH_HEADER_NAME=x-snow-user-name

# ─── Agent Studio 后台（Phase 4-4）───
# 测试环境默认用户自动获 admin，保证既有单测零回归
SNOW_STUDIO_OPEN=true
