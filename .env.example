# ───────── SnowHarness 环境变量 ─────────
#
# 环境区分通过 APP_ENV 控制（与 NODE_ENV 解耦）：
#   APP_ENV=development  → 加载 .env.development（本地开发，默认值）
#   APP_ENV=test         → 加载 .env.test（测试环境）
#   APP_ENV=production   → 加载 .env.production（生产环境）
#
# 实际密钥写入 .env.{APP_ENV}.local（已被 git 忽略），不要写进本文件。
# 部署环境（K8s / Docker -e）直接注入变量，不依赖 .env 文件。
#
# 加载优先级（从高到低）：
#   1. 平台注入（K8s / Docker -e）
#   2. .env.{APP_ENV}.local（开发者个人密钥，git 忽略）
#   3. .env.local（Next.js 个人覆盖，git 忽略）
#   4. .env.{APP_ENV}（环境默认值，提交 git）
#   5. .env（共享默认值，提交 git）

# ─── 环境标识 ───
# development | test | production（不设置则从 NODE_ENV 推导）
APP_ENV=development

# ─── 数据库 ───
# 【必填】MySQL 连接串（drizzle + mysql2 驱动）
#   形如 mysql://user:password@host:3306/snow_harness
DATABASE_URL=mysql://root:snowroot@127.0.0.1:3307/snow_harness

# ─── LLM / AI ───
# 【必填】LLM 密钥（OpenAI 兼容端点的 API key）
LLM_API_KEY=

# 【必填】OpenAI 兼容端点 base url
#   默认 TokenHub plan/v3：https://tokenhub.tencentmaas.com/plan/v3
#   公司内部网关 / 其他中转：换成对应地址即可（协议须为 OpenAI 兼容）
LLM_BASE_URL=https://tokenhub.tencentmaas.com/plan/v3

# 【可选】模型名（默认 DeepSeek V4 Flash）
SNOW_CHAT_MODEL=deepseek-v4-flash
SNOW_TITLE_MODEL=qwen-turbo
# GLM-5.x 默认 minimal；可显式设 none/minimal/low/medium/high/xhigh/max
SNOW_REASONING_EFFORT=
# 单个模型 step 的最大输出 token（含 reasoning 与工具参数）
SNOW_MAX_OUTPUT_TOKENS=16384

# 【External Runtime 必填】平台 Gateway 回调的公开基地址（必须可被独立 Runtime 访问）
# 例如 https://snow.example.com；会拼接 /gateway/v1/runtime-events、/tool-calls 等路径。
SNOW_CONTROL_PLANE_PUBLIC_URL=

# 【生产必填】context_handle HMAC 签名密钥，至少 32 个字符
# 使用 `openssl rand -hex 32` 生成，写入 .env.production.local，不要提交真实值
SNOW_CONTEXT_HANDLE_SECRET=

# ─── Hosted 控制面证据服务 ───
# 服务需提供受管制品证明读取和独立 Runtime Conformance Runner；生产地址必须 HTTPS。
SNOW_HOSTED_EVIDENCE_SERVICE_URL=
SNOW_HOSTED_EVIDENCE_SERVICE_TOKEN=
# builder identity -> base64 raw Ed25519 公钥，不要在此提交真实值。
SNOW_HOSTED_BUILDER_KEYS_JSON=
# Runner 签名身份注册表 JSON。每项显式绑定 keyId/publicKey/runnerIdentity/tenantScope，
# 并包含 validFrom/validUntil/revokedAt；缺失、非法或空数组时验签全部拒绝。
SNOW_RUNNER_SIGNING_IDENTITIES_JSON=
SNOW_HOSTED_EVIDENCE_TIMEOUT_MS=30000

# ─── 工作区 ───
# 【可选】工作区文件根目录（默认 workspaces）
SNOW_WORKSPACES_DIR=workspaces

# 认证在所有环境统一使用数据库账号与可撤销会话。
# 初始管理员只通过 auth:bootstrap-admin 脚本创建，密码从权限为 0600 的文件读取。
# 企业用户适配器：default 使用标准 UserIdentity；enterprise 必须由部署方注册私有适配器
SNOW_ENTERPRISE_USER_ADAPTER=default

# ─── 外部 Agent 宿主交互 ───
# confirmation 的平台有效期（秒，60–86400；非法值回退为 900）。外部 Agent 不能自行设置。
SNOW_EXTERNAL_AGENT_CONFIRMATION_TTL_SECONDS=900
# 允许在员工界面打开的外部 HTTPS host，逗号分隔；留空即拒绝所有外链与人工支持入口。
SNOW_HOST_ACTION_EXTERNAL_ALLOWED_HOSTS=
