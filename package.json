{
  "name": "snow-harness",
  "version": "0.1.0",
  "description": "SnowHarness Web and macOS desktop client",
  "author": "SnowHarness Contributors",
  "main": "desktop/bundle/main/index.js",
  "private": true,
  "scripts": {
    "dev": "APP_ENV=development next dev --turbo",
    "dev:test": "APP_ENV=test next dev --turbo",
    "build": "next build",
    "build:dev": "APP_ENV=development next build",
    "build:test": "APP_ENV=test next build",
    "build:prod": "APP_ENV=production next build",
    "start": "next start",
    "start:dev": "APP_ENV=development next start",
    "start:test": "APP_ENV=test next start",
    "start:prod": "APP_ENV=production next start",
    "typecheck": "rm -rf .next/dev/types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx lib/db/seed.ts",
    "db:purge-retention": "tsx lib/db/purge-retention.ts",
    "build:runtime": "docker build -t snow-harness-runtime:node22 docker/runtime",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "security:audit": "pnpm audit --audit-level moderate",
    "security:license": "node scripts/check-licenses.mjs",
    "security:check": "pnpm security:license && pnpm security:audit",
    "contracts:verify": "node scripts/v11-contracts.mjs",
    "contracts:update": "node scripts/v11-contracts.mjs --write",
    "architecture:check": "depcruise --config dependency-cruiser.config.cjs lib",
    "worker:hosted-provisioning": "tsx scripts/workers/hosted-provisioning-worker.ts",
    "worker:control-plane-outbox": "tsx scripts/workers/control-plane-outbox-worker.ts",
    "routes:rebuild-eligibility": "tsx scripts/routes-rebuild-eligibility.ts",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "VERIFY_SKIP_BUILD=1 node scripts/verify.mjs",
    "dev:desktop": "pnpm build:desktop && pnpm rebuild:desktop-native && electron desktop/package-app",
    "build:desktop": "pnpm build:desktop-renderer && tsc -p desktop/tsconfig.json && node scripts/build-desktop.mjs",
    "build:desktop-renderer": "node scripts/build-desktop-renderer.mjs",
    "rebuild:desktop-native": "node scripts/rebuild-desktop-native.mjs",
    "package:desktop": "pnpm build:desktop && pnpm rebuild:desktop-native && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config desktop/electron-builder.yml --mac --arm64",
    "package:desktop:signed": "pnpm build:desktop && pnpm rebuild:desktop-native && electron-builder --config desktop/electron-builder.yml --mac --arm64",
    "architecture:gate": "npx tsx scripts/architecture-gate.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.50",
    "@ai-sdk/react": "3.0.118",
    "@base-ui/react": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-virtual": "^3.14.3",
    "ai": "6.0.116",
    "ajv": "^8.20.0",
    "better-sqlite3": "11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.34.1",
    "execa": "^9.6.1",
    "gpt-tokenizer": "^3.4.0",
    "js-yaml": "^5.1.0",
    "lucide-react": "^1.26.0",
    "motion": "^12.42.2",
    "mysql2": "^3.11.0",
    "nanoid": "^5.1.11",
    "next": "16.2.0",
    "next-themes": "^0.4.6",
    "officeparser": "^7.2.1",
    "pdf-parse": "^2.4.5",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.0",
    "simple-git": "^3.36.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@electron/rebuild": "3.6.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testcontainers/mysql": "^12.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.5.13",
    "dependency-cruiser": "^18.1.1",
    "drizzle-kit": "^0.25.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-updater": "^6.8.9",
    "esbuild": "0.25.12",
    "happy-dom": "^20.10.6",
    "playwright": "^1.61.1",
    "postcss": "^8.5.6",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4.3.1",
    "testcontainers": "^12.0.3",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "7.3.5",
    "vitest": "^3.2.1"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
