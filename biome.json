{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "files": {
    "ignore": [
      "drizzle/**",
      ".next/**",
      ".next-e2e/**",
      ".playwright-cli/**",
      "test-results/**",
      "node_modules/**",
      "workspaces/**",
      "docs/**",
      ".omc/**",
      ".omx/**",
      ".test-workspaces*/**",
      ".snow/**",
      ".codify/**",
      "desktop/dist/**",
      "desktop/release/**",
      "desktop/bundle/**",
      "desktop/renderer-dist/**",
      "desktop/package-app/**",
      "/release/**"
    ]
  },
  "overrides": [
    {
      "include": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "include": ["components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    }
  ]
}
