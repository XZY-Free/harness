# ───────── 开发环境（本地 next dev）─────────
# 复制本文件为 .env.development.local 并填入真实密钥（.local 已被 git 忽略）。
# Next.js 在 next dev 时自动加载本文件（NODE_ENV=development）。

# 【必填】MySQL 连接串 — 本地 Docker 容器
DATABASE_URL=mysql://root:snowroot@127.0.0.1:3307/snow_harness

# 【必填】LLM 密钥（OpenAI 兼容端点的 API key）
LLM_API_KEY=

# 【必填】OpenAI 兼容端点 base url
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 【可选】模型名
SNOW_CHAT_MODEL=glm-5.2
SNOW_TITLE_MODEL=qwen-turbo
SNOW_REASONING_EFFORT=minimal
SNOW_MAX_OUTPUT_TOKENS=16384

# 【可选】工作区文件根目录
SNOW_WORKSPACES_DIR=workspaces

# ─── 认证 / SSO（Phase 4-3）───
# 本地开发用 dev 固定默认用户；联调 trusted-headers 时改为 trusted-headers 并由本地代理注入 header
SNOW_AUTH_MODE=dev
SNOW_AUTH_HEADER_EXTERNAL_ID=x-snow-user-id
SNOW_AUTH_HEADER_EMAIL=x-snow-user-email
SNOW_AUTH_HEADER_NAME=x-snow-user-name

# ─── Agent Studio 后台（Phase 4-4）───
# dev 下默认用户自动获 admin 直进 /studio（本地零回归）
SNOW_STUDIO_OPEN=true
