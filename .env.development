# ───────── 开发环境（本地 next dev）─────────
# 复制本文件为 .env.development.local 并填入真实密钥（.local 已被 git 忽略）。
# Next.js 在 next dev 时自动加载本文件（NODE_ENV=development）。

# 【必填】MySQL 连接串 — 本地 Docker 容器
DATABASE_URL=mysql://root:nexroot@127.0.0.1:3307/nexharness

# 【必填】LLM 密钥（OpenAI 兼容端点的 API key）
LLM_API_KEY=

# 【必填】OpenAI 兼容端点 base url
LLM_BASE_URL=https://tokenhub.tencentmaas.com/plan/v3

# 【可选】模型名
NEX_CHAT_MODEL=deepseek-v4-flash
NEX_TITLE_MODEL=qwen-turbo
NEX_REASONING_EFFORT=high
NEX_MAX_OUTPUT_TOKENS=16384

# 【可选】工作区文件根目录
NEX_WORKSPACES_DIR=workspaces
NEX_FILE_IMAGE_UPLOAD_MAX_MB=10
NEX_FILE_DOCUMENT_UPLOAD_MAX_MB=20

# 认证在所有环境统一使用数据库账号与可撤销会话；管理员由 auth:bootstrap-admin 显式初始化。

# ─── 统一身份中心（auth-center；消费方模型）───
# auth-center 对外地址：开发期为本机门户（vite :3101，/api 反代到 API 服务）。
# 登录入口 302 到此地址；会话校验/权限快照/实时授权经此调用。
NEX_AUTH_CENTER_URL=http://localhost:3101
